@startuml

!theme plain
' skinparam linetype polyline
' skinparam linetype ortho
skinparam groupInheritance 1
skinparam Shadowing false
skinparam Class {
    BackgroundColor White
    ArrowColor #0078d7
    BorderColor #0078d7
}

sprite readOnly <svg viewBox="0 0 16 16">
<circle cx="8" cy="8" r="8" fill="#61dafb"/>
</svg>

sprite readWrite <svg viewBox="0 0 16 16">
<circle cx="8" cy="8" r="8" fill="#5fe038"/>
</svg>

title HSM IDE Class Diagram

package "Model" {
  class StateMachineModel {
    + name(): QString
    + setName(name)
    + root(): ModelRootState
    + clearModel()
    + createUniqueTransition(source, target): Transition
    + moveElement(elementId, newParentId): bool
    + reconnectElements(transitionId, newFromElementId, newToElementId): bool
    + idGenerator(): EntityIdGenerator
    + dump()

    --signals--
    + modelChanged()
    + modelEntityAdded(parent, entity)
    + modelEntityDeleted(parent, entity)
    + modelDataChanged(entity)
  }

  package "Elements" as ModelElements {
  class StateMachineEntity <<QObject>> {
    + id(): EntityID_t
    + type(): Type
    + setMetadata(key, value)
    + getMetadata(key): QVariant
    + setPos(pos)
    + getPos(): QPointF
    + setSize(size)
    + getSize(): QSizeF
    + accept(visitor: IModelVisitor)
    + addChild(child): bool
    + deleteChild(id)
    + deleteDirectChild(child)
    + deleteAllChildren()
    + findParentState(childId): StateMachineEntity
    + findChild(id, type): StateMachineEntity
    + properties(): QStringList
    + setProperty(key, value): bool
    + getProperty(key): QVariant
    + forEachChildElement(callback, depth, postOrder): bool

    --signals--
    + childAdded(parent, entity)
    + childRemoved(parent, entity)
    + modelDataChanged(entity)
  }

  class State {
    + stateType(): StateType
    + name(): QString
    + setName(name)
    + findChildStateByName(name): State

    - <$readOnly> mStateType: StateType
    - <$readWrite> mName: QString
  }

  class RegularState {
    + onStateChangedAction(): IModelAction
    + onEnteringAction(): IModelAction
    + onExitingAction(): IModelAction
    + setOnStateChangedAction(action)
    + setOnEnteringAction(action)
    + setOnExitingAction(action)
    + hasOnStateChangedAction(): bool
    + hasOnEnteringAction(): bool
    + hasOnExitingAction(): bool
    + addChild(child): bool
    + addChildState(child: State)
    + addTransition(child: Transition)
    + childrenEntities(): list<StateMachineEntity>
    + deleteChild(id)
    + deleteDirectChild(child)
    + deleteAllChildren()
    + findParentState(childId): StateMachineEntity
    + findChild(id, type): StateMachineEntity
    + findState(id): State
    + findChildStateByName(name): State
    + findRegularState(id): RegularState
    + findTransition(id): Transition
    + copyEntityData(other)
  }

  class ModelRootState {
    + properties(): QStringList
    + setProperty(key, value): bool
    + getProperty(key): QVariant
  }

  class Transition {
    + source(): State
    + target(): State
    + setSource(source)
    + setTarget(target)
    + sourceId(): EntityID_t
    + targetId(): EntityID_t
    + event(): QString
    + transitionType(): TransitionType
    + transitionAction(): IModelAction
    + conditionCallback(): QString
    + expectedConditionValue(): bool
    + setEvent(event)
    + setTransitionType(type)
    + setTransitionAction(action)
    + hasTransitionAction(): bool
    + setConditionCallback(callback)
    + setExpectedConditionValue(value)
    + copyEntityData(other)
  }

  class FinalState {
    + onStateChangedAction(): IModelAction
    + hasOnStateChangedAction(): bool
    + event(): QString
    + setEvent(event)
    + setOnStateChangedAction(action)
    + copyEntityData(other)
  }

  class HistoryState {
    + historyType(): HistoryType
    + setHistoryType(historyType)
    + setDefaultTransition(transition)
    + defaultTransition(): Transition
    + addChild(child): bool
    + deleteChild(id)
    + deleteDirectChild(child)
    + findParentState(childId): StateMachineEntity
    + findChild(id, type): StateMachineEntity
    + copyEntityData(other)
  }

  class InitialState {
    + setTransition(transition)
    + transition(): Transition
    + addChild(child): bool
    + deleteChild(id)
    + deleteDirectChild(child)
    + findParentState(childId): StateMachineEntity
    + findChild(id, type): StateMachineEntity
  }

  class EntryPoint {
    + transitions(): list<Transition>
    + addTransition(transition)
    + addChild(child): bool
    + deleteChild(id)
    + deleteDirectChild(child)
    + findParentState(childId): StateMachineEntity
    + findChild(id, type): StateMachineEntity
  }

  class ExitPoint {
    + event(): QString
    + onStateChangedAction(): IModelAction
    + onEnteringAction(): IModelAction
    + onExitingAction(): IModelAction
    + hasOnStateChangedAction(): bool
    + hasOnEnteringAction(): bool
    + hasOnExitingAction(): bool
    + setEvent(event)
    + setOnStateChangedAction(action)
    + setOnEnteringAction(action)
    + setOnExitingAction(action)
    + copyEntityData(other)
  }

  class IncludeEntity {
    + promoteFrom(state: RegularState)
    + path(): QString
    + setPath(path)
    + addChild(child): bool
  }
  }

  package "Actions" {
    interface IModelAction {
      + type(): ModelAction
      + properties(): QStringList
      + setProperty(key, value): bool
      + getProperty(key): QVariant
      + serialize(): QString
      + deserialize(data): bool
    }

    class ModelActionFactory {
      + {static} createModelAction(type): IModelAction
      + {static} createModelActionFromData(data, fallbackType): IModelAction
      + {static} actionName(type): QString
      + {static} actionTypeByName(name): ModelAction
      + {static} supportedActionNames(): QStringList
    }

    class CallbackAction
    class SendEventAction
    class TimerStartAction
    class TimerStopAction
    class TimerRestartAction
    class NoneAction

    IModelAction <|.. CallbackAction
    IModelAction <|.. SendEventAction
    IModelAction <|.. TimerStartAction
    IModelAction <|.. TimerStopAction
    IModelAction <|.. TimerRestartAction
    IModelAction <|.. NoneAction
    ModelActionFactory ..> IModelAction : creates
  }

  interface IModelVisitor {
    + visitRegularState(state)
    + visitEntryPoint(entryPoint)
    + visitExitPoint(exitPoint)
    + visitFinalState(finalState)
    + visitHistoryState(historyState)
    + visitInitialState(initialState)
    + visitIncludeEntity(include)
    + visitTransition(transition)
  }

  class ModelElementsFactory {
    + {static} createUniqueState(type, generator): State
    + {static} createStateWithId(type, id): State
    + {static} cloneStateEntity(source, generator): State
    + {static} createUniqueTransition(source, target, generator): Transition
    + {static} createTransitionWithId(source, target, event, id): Transition
    + {static} createInitialFrom(entryPoint, generator): State
    + {static} createFinalFrom(exitPoint, generator): State
  }

  class EntityIdGenerator {
    + generateNextId(): EntityID_t
    + registerRestoredId(id): bool
    + synchronizeCounter()
    + reset()
    + isAssigned(id): bool
    + currentCounter(): EntityID_t
  }

  class StateHierarchyRules {
    + {static} canBeTopLevel(elementType): bool
    + {static} canStateBeChildOf(parentType, childType): bool
    + {static} canTransitionBeChildOf(parentType): bool
    + {static} canAddEntityToParent(parent, child): bool
  }

  class StateMachineSerializer {
    + serializeToScxml(model, format, addScxmlTag): QString
    + deserializeFromScxml(scxml): StateMachineModel
    + deserializeFromScxml(scxml, outModel): bool
    + deserializeFromUnwrapperScxml(unwrapped, wrapper, outModel): bool
    + validateScxmlStructure(scxml): bool
  }

  package "Serializer" {
    interface IMetadataSerializer {
      + beginSerialization(writer, model)
      + notifyEnterState(entity)
      + notifyExitState(entity)
      + writeEntityAttributes(writer, entity)
      + writeEntityChildMetadata(writer, entity)
      + endSerialization(writer, model)
      + detectFormat(reader): DetectedFormat
      + resolveEntityId(reader, model): EntityID_t
      + parseMetadataElement(reader, entity, model): bool
      + parseTopLevelElement(reader, model): bool
      + endDeserialization(model)
      + format(): SerializationFormat
    }

    class HsmMetadataSerializer
    class QtCreatorMetadataSerializer

    class HsmLayoutSerializer {
      + writeEditorSection(model, writer)
      + parseEditorSection(reader, model)
    }

    IMetadataSerializer <|.. HsmMetadataSerializer
    IMetadataSerializer <|.. QtCreatorMetadataSerializer
    HsmMetadataSerializer *-- HsmLayoutSerializer
  }

  StateMachineEntity <|-- State
  StateMachineEntity <|-- Transition
  State <|-- FinalState
  State <|-- HistoryState
  State <|-- EntryPoint
  State <|-- InitialState
  State <|-- ExitPoint

  RegularState --|> State
  ModelRootState --|> RegularState
  IncludeEntity --|> RegularState

  EntryPoint "1" *-- "0..*" Transition: contains
  InitialState "1" *-- "0..1" Transition: contains
  HistoryState "1" *-- "0..1" Transition: default transition

  StateMachineModel "1" *-- "1" ModelRootState : contains
  RegularState "1" *-- "0..*" StateMachineEntity: children

  Transition "1" --> "2" State: references (source, target)
  RegularState "1" *-- "0..*" IModelAction: actions
  ExitPoint "1" *-- "0..*" IModelAction: actions
  FinalState "1" *-- "0..1" IModelAction: action

  StateMachineEntity ..> IModelVisitor : accept()
  StateMachineSerializer ..|> IModelVisitor
  StateMachineSerializer ..> StateMachineModel : serializes
  StateMachineSerializer ..> StateHierarchyRules : validates
  StateMachineSerializer "1" *-- "1" HsmMetadataSerializer : owns
  StateMachineSerializer "1" *-- "1" QtCreatorMetadataSerializer : owns
  ModelElementsFactory ..> State : creates
  ModelElementsFactory ..> Transition : creates
  ModelElementsFactory ..> EntityIdGenerator : uses
  StateMachineModel "1" *-- "1" EntityIdGenerator : owns
}

package "View" {
  package "Models" {
    class StateMachineEntityViewModel <<QAbstractItemModel>> {
      + rowCount(): int
      + columnCount(): int
      + index(row, column, parent): QModelIndex
      + parent(index): QModelIndex
      + data(index, role): QVariant
      + headerData(section, orientation, role): QVariant
      + selectEntityById(id)
      + selectEntity(entity)
      + setData(index, value, role): bool
      + flags(index): Qt::ItemFlags
      + setHistoryTransactionCallbacks(begin, commit)
    }

    class StateMachineTreeModel <<QAbstractItemModel>> {
      + index(row, column, parent): QModelIndex
      + parent(index): QModelIndex
      + rowCount(): int
      + columnCount(): int
      + data(index, role): QVariant
      + flags(index): Qt::ItemFlags
      + findModelEntity(id): QModelIndex
      + entiryFromIndex(index): StateMachineEntity
      + removeRows(row, count, parent): bool
      + onModelChanged()
      + onModelDataChanged(entity)
    }

    class FilteredFileSystemProxyModel <<QSortFilterProxyModel>> {
      + setShowEmptyFolders(enabled)
      + isShowEmptyFolders(): bool
      + getFilePath(proxyIndex): QString
      + isDir(proxyIndex): bool
    }
  }

  class MainWindow <<QMainWindow>> {
    + currentView(): HsmGraphicsView
    + getViewByIndex(index): HsmGraphicsView
    + handleNewFile()
    + handleOpenFile()
    + handleSave()
    + handleSaveAs()
    + handleUndo()
    + handleRedo()
    + handleCloseCurrentProject()
    + handleCloseAllProjects()
    + handleClipboardCopy()
    + handleClipboardCut()
    + handleClipboardPaste()
    + handleSelectAll()
    + handleEditSelected()
    + handleDuplicateSelected()
    + handleZoomIn()
    + handleZoomOut()
    + handleResetZoom()
    + handleFitToView()
    + handleToggleGrid(enabled)
    + handleToggleSnapToGrid(enabled)
    + handleAbout()
    + handleOpenWorkspace()
    + handleCloseWorkspace()
    + projectOpened(project)
    + projectSelected(project)
    + projectClosed(project)
  }

  class AboutDialog <<QDialog>>

  class HsmGraphicsView <<QGraphicsView>> {
    + setProjectController(controller)
    + createHsmElement(modelElement, typeId, pos, size, parentId): HsmElement
    + createHsmTransition(transition, fromId, toId): HsmTransition
    + deleteHsmElement(modelElementId)
    + clearAllHsmElements()
    + moveHsmElement(elementId, newParentId)
    + reconnectHsmTransition(transitionId, fromId, toId)
    + selectHsmElement(id)
    + selectAllHsmElements()
    + getSelectedElements(): list<EntityID_t>
    + deleteSelectedItems()
    + clearSelection()
    + zoomIn()
    + zoomOut()
    + resetZoom()
    + fitSceneToView()
    + beginSelectedElementEditing(): bool
    + findHsmElement(id): HsmElement
    + findHsmTransition(id): HsmTransition
    + setGridVisible(visible)
    + isGridVisible(): bool
    + setSnapToGridEnabled(enabled)
    + isSnapToGridEnabled(): bool
    + snapPointToGrid(scenePos): QPointF
    + {static} alignPointToGrid(scenePos): QPointF

    --signals--
    + hsmElementDoubleClickEvent(entity)
    + transformChanged()
  }

  class HsmTreeView <<QTreeView>> {
    + setModel(model)

    --signals--
    + elementDoubleClickEvent(element)
  }

  class HsmPropertiesTableView <<QTreeView>> {
    + setModel(model)
  }

  class HsmElementsList <<QListWidget>>

  class WorkspaceView <<QTreeView>> {
    + setWorkspaceRoot(rootDir)
    + clearWorkspace()
    + setShowEmptyFolders(enabled)
    + showEmptyFolders(): bool
    + createWorkspaceFileInSelection()
    + createWorkspaceFolderInSelection()
    + collapseWorkspaceTree()

    --signals--
    + workspaceFileActivated(path)
    + workspacePathRenamed(oldPath, newPath)
  }

  package "Elements" {
    class HsmElement <<QGraphicsObject>> {
      + init(modelEntity)
      + modelId(): EntityID_t
      + hightlight(enable)
      + isHighligted(): bool
      + setDragMode(dragging)
      + setGroupDragMode(enableGroup)
      + isDragged(): bool
      + elementType(): HsmElementType
      + elementRect(): QRectF
      + mapFromSceneToBody(point): QPointF
      + modelElementPtr(): StateMachineEntity
      + isConnectable(): bool
      + acceptsConnections(): bool
      + isResizable(): bool
      + canBeTopLevel(): bool
      + acceptsChildElement(type): bool
      + hsmChildItems(): list<QGraphicsItem>
      + isDirectChild(child): bool
      + containsChild(child): bool
      + childrenRect(): QRectF
      + hasSubstates(): bool
      + addChildItem(child)
      + removeChildItem(child)
      + setHsmParentItem(parent)
      + hsmParentItem(): HsmElement
      + onModelDataChanged()
      + viewTransformChanged()
    }

    class HsmConnectableElement {
      + init(modelElement)
      + isConnectable(): bool
      + acceptsConnections(): bool
      + hoverRect(): QRectF
      + hasVisibleArrows(): bool
      + viewTransformChanged()

      --signals--
      + elementConnected(fromId, toId)
    }

    class HsmResizableElement {
      + init(modelElement)
      + isResizable(): bool
      + resizeElement(newRect)
      + resizeToFitChildItem(child)
      + normalizeElementRect()
      + createBoundaryGrips()
      + updateGripsPosition(directionsList)
      + setGripVisibility(visible)
      + gripPoint(gripDirection): QPointF
      + setMinSize(minWidth, minHeight)
      + setMinWidth(minWidth)
      + setMinHeight(minHeight)
      + minSize(): QSizeF
    }

    class HsmRectangularElement {
      # paintRectangularBody(painter, brush)
    }

    class HsmRoundElement {
      # radius(): qreal
      # center(): QPointF
    }

    class HsmStateElement {
      + init(modelEntity)
      + hsmChildItems(): list<QGraphicsItem>
      + hasSubstates(): bool
      + addChildItem(child)
      + removeChildItem(child)
      + resizeToFitChildItem(child)
      + normalizeElementRect()
      + mapFromSceneToBody(point): QPointF
      + beginNameEditMode()
      + beginNameTypingMode(newText)
      + bodyBoundingRect(): QRectF
      + sceneBodyBoundingRect(): QRectF
    }

    class HsmIncludeElement

    class HsmTransition {
      + init(modelEntity)
      + hsmChildItems(): list<QGraphicsItem>
      + beginConnection(fromElement, pos)
      + isConnecting(): bool
      + moveConnectionTo(pos)
      + connectElements(fromElement, toElement)
      + disconnectElements()
      + beginEventEditMode()
      + beginEventTypingMode(newText)
      + isSelfTransition(): bool
      + connectionCandidate(): HsmElement
      + recalculateLine()

      --signals--
      + transitionReconnected(transitionId, fromId, toId)
    }

    class HsmEntryPointElement
    class HsmExitPointElement
    class HsmFinalElement
    class HsmHistoryElement
    class HsmInitialElement

    HsmConnectableElement -up-|> HsmElement
    HsmResizableElement -up-|> HsmConnectableElement
    HsmRectangularElement -up-|> HsmResizableElement
    HsmRoundElement -up-|> HsmConnectableElement

    HsmStateElement --|> HsmRectangularElement
    HsmIncludeElement --|> HsmStateElement

    HsmRoundElement <|-- HsmEntryPointElement
    HsmRoundElement <|-- HsmExitPointElement
    HsmRoundElement <|-- HsmFinalElement
    HsmRoundElement <|-- HsmHistoryElement
    HsmRoundElement <|-- HsmInitialElement
    HsmElement <|-- HsmTransition
  }

  MainWindow "1" *-- "1" HsmGraphicsView : contains
  MainWindow "1" *-- "1" HsmTreeView : contains
  MainWindow "1" *-- "1" HsmElementsList : contains
  MainWindow "1" *-- "1" HsmPropertiesTableView : contains
  MainWindow "1" *-- "1" WorkspaceView : contains

  HsmTreeView "1" *-- "1" StateMachineTreeModel : contains
  HsmPropertiesTableView "1" *-- "1" StateMachineEntityViewModel : contains
}

package "Supporting Elements" {
  class ElementGripItem <<QGraphicsObject>> {
    + init()
    + annotationElement(): HsmElement
    + renderingPos(): QPointF
    + renderingPosScene(): QPointF
    + direction(): GripDirection

    --signals--
    + gripMoved(grip, delta)
    + onGripDoubleClick(gripItem)
    + onGripLostFocus(gripItem)
    + onGripMoveEnterEvent(gripItem)
    + onGripMoveLeaveEvent(gripItem)
  }

  class ElementBoundaryGripItem {
    + annotationElement(): HsmResizableElement
    + directionType(): GripDirectionType
  }

  class ElementConnectionArrow <<QGraphicsObject>> {
    + direction(): Direction
    + setPos(pos)

    --signals--
    + connectionPositionChanged(arrow, scenePos)
    + connectionStarted(arrow, scenePos)
    + connectionFinished(arrow, scenePos)
  }

  class HsmElementsFactory {
    + {static} createElementsList(): list<QListWidgetItem>
    + {static} getElementIcon(typeId): QString
    + {static} getStateIcon(type): QString
    + {static} createElement(typeId, modelElement): HsmElement
    + {static} createElement(typeId, modelElement, size): HsmElement
    + {static} elementTypeFromTypeId(typeId): HsmElementType
  }

  class ThemeManager <<singleton>> {
    + {static} instance(): ThemeManager
    + theme(): Theme
    + setTheme(theme)

    --signals--
    + themeChanged()
  }

  ElementGripItem <|-- ElementBoundaryGripItem
  HsmResizableElement "1" *-- "0..8" ElementBoundaryGripItem : boundary grips
  HsmConnectableElement "1" *-- "0..4" ElementConnectionArrow : arrows
  HsmConnectableElement "1" -- "0..*" HsmTransition: transitions
  HsmElementsFactory ..> HsmElement : creates
}

package "Controller" {
  class MainEditorController <<QObject>> {
    + start(): int
    + createProject(): ProjectController
    + openProject(projectPath): ProjectController
    + closeProject(project)
    + switchToProject(project)
    + closeAllProjects()
    + openedProjects(): list<ProjectController>
    + getProjectByPath(projectPath): ProjectController
    + handleWorkspacePathRenamed(oldPath, newPath)
    + handleHsmElementDoubleClick(entity)

    --signals--
    + projectOpened(project)
    + projectSelected(project)
    + projectClosed(project)
    + hsmProjectOpened(path)
  }

  interface IProjectController <<QObject>> {
    + importModel(path): bool
    + exportModel(): bool
    + exportModel(path): bool
    + updateModelPath(newPath)
    + handleViewDropEvent(elementTypeId, parentPos, targetElementId)
    + handleViewMoveEvent(draggedElementId, targetElementId)
    + handleDeleteElements(elementIDs)
    + serializeElementsToScxml(elementIDs): QString
    + pasteScxmlElements(scxmlContent, selectedIDs, cursorPos, useCursor): bool
    + beginHistoryTransaction(label)
    + commitHistoryTransaction()
    + cancelHistoryTransaction()
    + markHistoryElement(elementId)
    + unmarkHistoryElement(elementId)
    + undo(): bool
    + redo(): bool
    + canUndo(): bool
    + canRedo(): bool
  }

  class ProjectController {
    + registerView(view)
    + view(): HsmGraphicsView
    + hsmStructureModel(): StateMachineTreeModel
    + hsmEntityViewModel(): StateMachineEntityViewModel
    + id(): QString
    + name(): QString
    + modelPath(): QString
    + isModified(): bool
    + importModel(path): bool
    + exportModel(): bool
    + exportModel(path): bool
    + updateModelPath(newPath)
    + handleViewDropEvent(elementTypeId, parentPos, targetElementId)
    + handleViewMoveEvent(draggedElementId, targetElementId)
    + handleDeleteElements(elementIDs)
    + serializeElementsToScxml(elementIDs): QString
    + pasteScxmlElements(scxmlContent, selectedIDs, cursorPos, useCursor): bool
    + beginHistoryTransaction(label)
    + commitHistoryTransaction()
    + cancelHistoryTransaction()
    + markHistoryElement(elementId)
    + unmarkHistoryElement(elementId)
    + undo(): bool
    + redo(): bool
    + canUndo(): bool
    + canRedo(): bool

    --signals--
    + projectModelChanged(project)
  }

  class ModificationHistoryController {
    + beginTransaction(label)
    + commitTransaction()
    + cancelTransaction()
    + markChanged(entityId)
    + unmarkChanged(entityId)
    + onModelEntityAdded(parentId, entityId)
    + onModelEntityDeleted(parentId, entityId)
    + onModelDataChanged(entityId)
    + undo(): bool
    + redo(): bool
    + canUndo(): bool
    + canRedo(): bool
    + transactionActive(): bool
    + isRestoring(): bool
  }

  class SettingsController {
    + addRecentHsm(path)
    + addRecentWorkspace(path)
    + clearRecentHsm()
    + clearRecentWorkspaces()
    + removeRecentHsm(path)
    + removeRecentWorkspace(path)
    + recentHsm(): QStringList
    + recentWorkspaces(): QStringList
  }

  class RecentFilesManager {
    + loadRecentItems()
    + onActionClearRecentHSM()
    + onActionClearRecentLogs()
    + addPathToRecentHSMList(path)
    + addPathToRecentLogsList(path)
  }

  IProjectController <|-- ProjectController
  MainEditorController "1" *-- "0..*" ProjectController
  MainEditorController "1" *-- "1" MainWindow
  ProjectController "1" *-- "1" ModificationHistoryController
  ProjectController "1" *-- "1" StateMachineModel : owns
  ProjectController "1" *-- "1" StateMachineTreeModel : owns
  ProjectController "1" *-- "1" StateMachineEntityViewModel : owns

  MainWindow "1" *-- "1" SettingsController
}

' Model-View-Controller Relationships
MainEditorController --> StateMachineModel : manipulates
StateMachineModel ..> MainEditorController : notifies
MainWindow ..> MainEditorController : sends events

StateMachineEntityViewModel "1" o-- "1" StateMachineEntity: references
StateMachineTreeModel "1" o-- "1" StateMachineModel: references

' Element Connections
HsmTransition "1" --> "1" HsmElement : from
HsmTransition "1" --> "1" HsmElement : to

' View-Model Mapping
HsmElement "1" o-- "1" StateMachineEntity: references

' View-Controller Mapping
HsmGraphicsView ..> IProjectController: reference

' State hierarchy rule usage
HsmElement ..> StateHierarchyRules : validates
ProjectController ..> StateHierarchyRules : validates

@enduml
