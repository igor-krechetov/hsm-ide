section "REQ-300: Import/Export" {

  Software_Requirement REQ_300 {
    uid = "REQ-300"
    title = "Import/Export"
    description = "Reading and writing state machines in external file formats."
    status = Status.Partial
  }

  section "REQ-301: SCXML file handling" {

    Software_Requirement REQ_301 {
      uid = "REQ-301"
      title = "SCXML file handling"
      description = "Importing and exporting SCXML 1.0 state machine files."
      status = Status.Partial
    }

    section "REQ-301a: Import SCXML 1.0 files" {

      Software_Requirement REQ_301a {
        uid = "REQ-301a"
        title = "Import SCXML 1.0 files"
        description = "The serializer imports SCXML 1.0 files into the editor model."
        status = Status.Partial
      }

      section "REQ-301a1: Model structure import" {

        Software_Requirement REQ_301a1 {
          uid = "REQ-301a1"
          title = "Model structure import"
          description = "The structural content of an SCXML file (states, transitions) is imported into the model."
          status = Status.Partial
        }

        Software_Requirement REQ_301a1_1 {
          uid = "REQ-301a1.1"
          title = "Basic structure import"
          description = "Basic SCXML structure such as states and transitions is imported."
          status = Status.Done
        }

        Software_Requirement REQ_301a1_2 {
          uid = "REQ-301a1.2"
          title = "Support for parsing import element"
          description = "The importer parses SCXML import elements that reference external files."
          status = Status.Done
        }

        Software_Requirement REQ_301a1_3 {
          uid = "REQ-301a1.3"
          title = "Report parse errors to user with line numbers"
          description = "Parse errors encountered during import should be reported to the user with line numbers."
          status = Status.Done
          details = '''
- Parse errors are displayed in a dialog after import attempt
- Errors include line and column numbers where available
- Multiple errors are listed (not just first one)
- Non-fatal warnings are distinguished from fatal errors
- Dialog is shown even for partial success with warnings
'''
        }
      }

      Software_Requirement REQ_301a2 {
        uid = "REQ-301a2"
        title = "Model layout import"
        description = "Diagram layout information stored alongside the SCXML is imported so the diagram looks as saved."
        status = Status.Done
      }
    }

