  section "REQ-102: Transition management" {

    Software_Requirement REQ_102 {
      uid = "REQ-102"
      title = "Transition management"
      description = "Creating, editing and configuring transitions between state machine elements."
      status = Status.Done
    }

    section "REQ-102a: Visual transition creation" {

      Software_Requirement REQ_102a {
        uid = "REQ-102a"
        title = "Visual transition creation"
        description = "Transitions can be created visually by connecting source and target elements on the canvas."
        status = Status.Done
      }

      Software_Requirement REQ_102a1 {
        uid = "REQ-102a1"
        title = "Arrows for connectable elements"
        description = "The canvas shows connection arrows/handles on elements that can be used as a transition source or target."
        status = Status.Done
      }

      Software_Requirement REQ_102a2 {
        uid = "REQ-102a2"
        title = "Highlight for connectable elements"
        description = "Elements that can accept a transition connection are highlighted while the user is drawing one."
        status = Status.Done
      }

      Software_Requirement REQ_102a3 {
        uid = "REQ-102a3"
        title = "Transition rendering"
        description = "Transitions are rendered as arrows whose endpoints are computed geometrically and attached to the borders of their source and target elements."
        status = Status.Done
        details = '''
- Each endpoint is placed where a perpendicular dropped from the adjacent point meets the nearest element edge. The adjacent point is the closest intermediate grip, or the opposite endpoint when the transition has no intermediate grips.
- When no perpendicular foot lands within the edge span, the endpoint falls back to the center of the nearest edge.
- When a transition has no intermediate grips and its two elements face each other with overlapping edges, it is drawn as a straight perpendicular segment anchored at the centers of the overlapping edge spans.
- Endpoints always attach to the element border, never inside it.
- Endpoints are derived purely from current geometry; stored anchor hints (such as Qt Creator startTargetFactors/endTargetFactors) are not used.
- A transition is raised above neighbouring transitions while its grips are shown (on hover, selection or reconnection) so its grips and label are not covered.
'''
      }

      Software_Requirement REQ_102a4 {
        uid = "REQ-102a4"
        title = "Change transition source/target"
        description = "An existing transition can be re-pointed by dragging its endpoints to a different source or target element."
        status = Status.Done
      }
    }

    Software_Requirement REQ_102b {
      uid = "REQ-102b"
      title = "Event labeling"
      description = "A transition can be labeled with the event that triggers it."
      status = Status.Done
    }

    Software_Requirement REQ_102c {
      uid = "REQ-102c"
      title = "Guard condition specification"
      description = "A transition can carry a guard condition that must hold for the transition to fire."
      status = Status.Done
    }

    Software_Requirement REQ_102d {
      uid = "REQ-102d"
      title = "Internal/External transitions"
      description = "A transition can be configured as internal or external, controlling whether entry/exit actions run."
      status = Status.Done
    }

    Software_Requirement REQ_102e {
      uid = "REQ-102e"
      title = "Self-transitions"
      description = "A state can have a self-transition whose source and target are the same state."
      status = Status.Done
    }

    Software_Requirement REQ_102f {
      uid = "REQ-102f"
      title = "Transition actions"
      description = "A transition can define actions that execute when the transition is taken."
      status = Status.Done
    }
  }

