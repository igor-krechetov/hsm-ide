// =============================================================================
// hsm-ide Software Requirements
// =============================================================================
// Converted from requirements/requirements.pu (the PlantUML WBS that is the
// source of truth). Every WBS node becomes one Software_Requirement record and
// NO requirement id or title has been dropped.
//
// Hierarchy: the .pu tree is preserved via nested TRLC `section "UID: Title"`
// blocks. A node that has children both (a) emits its own record and (b) opens
// a section that nests its children, so parent ids/titles are never lost and
// document (reading) order is preserved.
//
// status maps the .pu <<class>> style to implementation state:
//   <<done>> -> Done, <<in_progress>> -> InProgress, <<todo>> -> Todo,
//   <<partial>> -> Partial, <<prio_low>> -> PrioLow.
// Unclassified nodes (REQ-000 root, REQ-205 Custom Widgets) default to
// Status.Partial: both are container nodes whose children are a mix of done
// and not-done, so Partial is the honest roll-up.
//
// uid holds the ORIGINAL id verbatim (keeps '-' and '.'); the record name is a
// normalized TRLC identifier (replace '-' and '.' with '_').
//
// The source .pu has four DUPLICATE ids. TRLC record names must be unique, so
// the second occurrence of each gets a `_dup2` record name (uid field kept
// verbatim). The duplicates are:
//   REQ-103b2   (Minimum size for resizable elements / Moving elements)
//   REQ-103e3b  (Move substate to top level / Move multiple elements)
//   REQ-202c3   (fit to view shortcut / reset zoom shortcut)
//   REQ-205b2   (delete tree elements / select tree elements and focus update)
// =============================================================================

package HSM_IDE

Software_Requirement REQ_000 {
  uid = "REQ-000"
  title = "SCXML State Machine Editor"
  description = "Root product: a graphical editor for designing, editing and exporting SCXML hierarchical state machines."
  status = Status.Partial
}

