    section "REQ-103f: Hierarchy Restrictions" {

      Software_Requirement REQ_103f {
        uid = "REQ-103f"
        title = "Hierarchy Restrictions"
        description = "Structural rules constraining where elements may be placed within the state hierarchy."
        status = Status.Partial
      }

      Software_Requirement REQ_103f1 {
        uid = "REQ-103f1"
        title = "History state must have a parent state"
        description = "A history pseudo-state is only valid inside a parent state and cannot exist at the top level."
        status = Status.Done
      }

      Software_Requirement REQ_103f2 {
        uid = "REQ-103f2"
        title = "Entry point must have a parent state"
        description = "An entry point is only valid inside a parent state and cannot exist at the top level."
        status = Status.Done
      }

      Software_Requirement REQ_103f3 {
        uid = "REQ-103f3"
        title = "Exit point must have a parent state"
        description = "An exit point is only valid inside a parent state and cannot exist at the top level."
        status = Status.Done
      }

      Software_Requirement REQ_103f4 {
        uid = "REQ-103f4"
        title = "Initial and final states shall be top level only"
        description = "Initial and final states are restricted so they may only appear at the top level of the hierarchy."
        status = Status.Done
      }

      Software_Requirement REQ_103f5 {
        uid = "REQ-103f5"
        title = "Visual indication of restricted action"
        description = "The editor gives visual feedback when a user attempts an action that the hierarchy rules forbid."
        status = Status.Done
      }

      Software_Requirement REQ_103f6 {
        uid = "REQ-103f6"
        title = "Only one initial state allowed in the model"
        description = "The model should enforce that at most one initial state exists per state machine."
        status = Status.Done
        details = '''
- Only one initial state is allowed at the model root level
- Attempting to add a second initial state shows visual indication (forbidden cursor), consistent with existing REQ-103f restrictions
- Drag, drop, and paste operations respect this constraint
'''
      }

      Software_Requirement REQ_103f7 {
        uid = "REQ-103f7"
        title = "State names must be unique across the model"
        description = "The model should enforce that every state name is unique across the whole state machine."
        status = Status.Done
        details = '''
- Creating a state with a name that already exists is prevented
- Renaming a state to an existing name is prevented
- Visual indication shown (forbidden cursor or inline error)
- Check is global across the entire model (not just siblings)
- Error message explains the constraint
'''
      }
    }
  }

