<?xml version="1.0"?>
<scxml encoding="UTF-8" version="1.0" xmlns="http://www.w3.org/2005/07/scxml" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:hsm="https://hsm-ide.dev/scxml" name="all_elements">
    <state id="ParentState" hsm:uid="2">
        <initial hsm:uid="3">
            <transition event="NEW_EVENT" type="external" target="Child1" hsm:uid="4"/>
            <transition event="NEW_EVENT" type="external" target="Child2" hsm:uid="5"/>
        </initial>
        <transition event="NEW_EVENT" type="external" target="NeigborState" hsm:uid="6"/>
        <final id="ExitPoint_Event" hsm:uid="7" event="EVENT3"/>
        <state id="Child1" hsm:uid="8">
            <onentry>
                <script>onEntering</script>
                <script>start_timer(NEW_TIMER, 1000, false)</script>
            </onentry>
            <onexit>
                <script>onExit</script>
                <script>stop_timer(NEW_TIMER)</script>
                <script>transition(NEW_EVENT, 123, 456)</script>
            </onexit>
            <invoke srcexpr="onChanged"/>
            <transition event="NEW_EVENT" type="external" target="ExitPoint_Event" hsm:uid="9">
                <script>onTransition</script>
            </transition>
            <transition event="NEW_EVENT" type="external" target="ExitPoint_Default" hsm:uid="32"/>
        </state>
        <history id="HistoryShallow" type="shallow" hsm:uid="10"/>
        <state id="Child2" hsm:uid="11">
            <state id="Child2_1" hsm:uid="20">
                <onentry>
                    <script>restart_timer(NEW_TIMER)</script>
                </onentry>
                <transition event="NEW_EVENT" type="external" target="Child2_2" hsm:uid="23"/>
            </state>
            <state id="Child2_2" hsm:uid="22">
                <invoke srcexpr="callbackName"/>
                <transition event="NEW_EVENT" type="internal" target="Child2_2" cond="condition1 is false" hsm:uid="29">
                    <script>callbackName</script>
                </transition>
                <transition event="NEW_EVENT" type="external" target="Child2_2" cond="condition2 is true" hsm:uid="30">
                    <script>start_timer(NEW_TIMER, 1000, true)</script>
                </transition>
            </state>
            <initial hsm:uid="24">
                <transition type="external" target="Child2_1" hsm:uid="25"/>
            </initial>
            <transition event="NEW_EVENT" type="external" target="Child1" hsm:uid="27"/>
        </state>
        <history id="HistoryDeep" type="deep" hsm:uid="19"/>
        <final id="ExitPoint_Default" hsm:uid="31">
            <onentry>
                <script>callbackName</script>
                <script>start_timer(NEW_TIMER, 1000, false)</script>
            </onentry>
            <onexit>
                <script>callbackName</script>
                <script>stop_timer(NEW_TIMER)</script>
            </onexit>
            <invoke srcexpr="callbackName"/>
        </final>
    </state>
    <state id="NeigborState" hsm:uid="33">
        <onentry>
            <script>callbackName</script>
        </onentry>
        <onexit>
            <script>callbackName</script>
        </onexit>
        <invoke srcexpr="callbackName"/>
        <transition event="NEW_EVENT" type="external" target="FinalState1" hsm:uid="13"/>
        <transition event="NEW_EVENT" type="external" target="HistoryShallow" hsm:uid="14"/>
        <transition event="NEW_EVENT" type="external" target="HistoryDeep" cond="condition1 is true" hsm:uid="26">
            <script>onTransition</script>
        </transition>
        <xi:include href="transitions.scxml" parse="xml"/>
    </state>
    <initial hsm:uid="16">
        <transition type="external" target="ParentState" hsm:uid="17"/>
    </initial>
    <final id="FinalState1" hsm:uid="18">
        <onentry>
            <script>callbackName</script>
        </onentry>
        <invoke srcexpr="callbackName"/>
    </final>
