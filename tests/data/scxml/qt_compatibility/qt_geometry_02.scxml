<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" binding="early" xmlns:qt="http://www.qt.io/2015/02/scxml-ext" xmlns:xi="http://www.w3.org/2001/XInclude" encoding="UTF-8" name="qt_geometry_02" qt:editorversion="7.0.0" initial="state_1">
    <qt:editorinfo initialGeometry="-200;160;0;0;40;40"/>
    <state id="state_1">
        <qt:editorinfo scenegeometry="200;150;0;0;400;300" geometry="200;150;-200;-150;400;300"/>
        <initial>
            <qt:editorinfo scenegeometry="200;150;180;130;40;40" geometry="0;0;-20;-20;40;40"/>
            <transition target="state_1_1"/>
        </initial>
        <transition type="external" event="EVENT_1" target="state_2"/>
        <state id="state_1_1">
            <qt:editorinfo scenegeometry="300;220;220;180;160;80" geometry="100;70;-80;-40;160;80"/>
        </state>
    </state>
    <state id="state_2">
        <qt:editorinfo scenegeometry="650;100;500;0;300;200" geometry="650;100;-150;-100;300;200"/>
        <state id="state_2_1">
            <qt:editorinfo scenegeometry="730;150;640;100;180;100" geometry="80;50;-90;-50;180;100"/>
        </state>
    </state>
</scxml>
